NODE_ENV=production
PORT=5001
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/landledger
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated frontend origins allowed to call this API.
CORS_ORIGINS=https://your-landledger.vercel.app

# Configure a persistent cloud upload provider before production; local uploads
# are not durable on serverless/container hosts.
